# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NOX Voice AI — Environment Variables
# Copy this to .env and fill in your values
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Server
PORT=4000

# Firebase Admin (Service Account)
FIREBASE_PROJECT_ID=noed-4008d
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@noed-4008d.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Groq (FREE — LLM + STT, no payment needed!)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key

# OpenAI (optional backup — not used by default)
# OPENAI_API_KEY=sk-your-openai-api-key

# Connected Apps (CORS origins)
CUSTOMER_APP_URL=http://localhost:3000
VENDOR_APP_URL=http://localhost:3001
RIDER_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3003

# Telephony (Phase 2 — uncomment when ready)
# EXOTEL_SID=your-exotel-sid
# EXOTEL_TOKEN=your-exotel-token
# EXOTEL_PHONE=your-exotel-phone-number
# TWILIO_SID=your-twilio-sid
# TWILIO_TOKEN=your-twilio-auth-token
# TWILIO_PHONE=+91xxxxxxxxxx

# SMS Provider (Phase 2 — uncomment when ready)
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_TEMPLATE_ID=your-template-id

# Human Agent Transfer
HUMAN_AGENT_QUEUE_NUMBER=+919566700534
